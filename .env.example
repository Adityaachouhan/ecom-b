# Copy to .env.development / .env.production (and .env for Prisma CLI).
# The API loads .env.<NODE_ENV> first, then falls back to .env.

# --- Development (.env.development) ---
NODE_ENV=development
PORT=3001
JWT_SECRET=atmosphere-dev-secret-change-in-production
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=TEST1234
DB_NAME=E-commerce
DATABASE_URL="postgresql://postgres:TEST1234@localhost:5432/E-commerce?schema=public"

# Shipping webhook secret for POST /api/webhooks/shipping/:provider
SHIPPING_WEBHOOK_SECRET=dev-shipping-secret

# --- Production (.env.production) ---
# NODE_ENV=production
# PORT=3001
# JWT_SECRET=change-me-to-a-long-random-secret
# CORS_ORIGIN=https://your-frontend-domain.com
# DB_HOST=your-db-host
# DB_PORT=5432
# DB_USER=your-db-user
# DB_PASSWORD=your-db-password
# DB_NAME=E-commerce
# DATABASE_URL="postgresql://your-db-user:your-db-password@your-db-host:5432/E-commerce?schema=public"
